# Copy to .env.local, fill in, then restart the app (npm start / npm run dev).
# Never commit .env.local — it holds secrets.

# ── Real SMS for Indian numbers (+91) ─────────────────────────────
# Fast2SMS "Quick SMS" route: no DLT template needed. Get the key from
# https://www.fast2sms.com → Dev API. Used for +91 numbers when set.
FAST2SMS_API_KEY=

# ── Real SMS for Singapore (+65), and India if Fast2SMS isn't set ──
# https://console.twilio.com → Account SID, Auth Token, and a Twilio phone number.
# Trial accounts only deliver to numbers you have verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Optional ─────────────────────────────────────────────────────
# Raises the data.gov.sg rate limit for the pipeline and live feeds.
DATA_GOV_SG_API_KEY=
